/* 全局基础样式 */
page {
    background-color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  
  /* 页面容器 */
  .index-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }
  
  /* 顶部搜索栏 */
  .search-bar {
    background-color: #fff;
    padding: 20rpx 30rpx;
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    background-color: #f5f5f5;
    border-radius: 30rpx;
    padding: 15rpx 25rpx;
  }
  .search-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 15rpx;
  }
  .search-input {
    flex: 1;
    font-size: 28rpx;
    color: #666;
  }
  
  /* 商品列表滚动容器 */
  .goods-scroll {
    flex: 1;
    padding: 20rpx;
  }
  .goods-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  
  /* 商品卡片（核心电商风格） */
  .goods-card {
    width: 48%;
    background-color: #fff;
    border-radius: 16rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
    position: relative;
  }
  
  /* 商品图片 */
.goods-img {
    width: 100%;
    height: 260rpx;
    /* 去掉原来的灰色背景 */
    background-color: transparent;
  }
  
  /* 商品信息区域 */
  .goods-info {
    padding: 20rpx;
  }
  .goods-title {
    font-size: 28rpx;
    color: #333;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .goods-tag {
    display: inline-block;
    margin-top: 10rpx;
    padding: 4rpx 12rpx;
    background-color: #e8f5e9;
    color: #ff9800;
    font-size: 22rpx;
    border-radius: 4rpx;
  }
  
  /* 价格区域 */
  .price-row {
    margin-top: 15rpx;
    display: flex;
    align-items: baseline;
  }
  .price-symbol {
    font-size: 24rpx;
    color: #ff4d4f;
  }
  .price-num {
    font-size: 36rpx;
    color: #ff4d4f;
    font-weight: bold;
  }
  .price-unit {
    font-size: 24rpx;
    color: #999;
    margin-left: 4rpx;
  }
  
  .goods-tip {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #999;
    line-height: 1.4;
  }
  
  /* 加购按钮 */
  .add-cart-btn {
    position: absolute;
    bottom: 20rpx;
    right: 20rpx;
    width: 60rpx;
    height: 60rpx;
    background-color: #ff9800;
    border-radius: 50%;
    color: #fff;
    font-size: 36rpx;
    text-align: center;
    line-height: 60rpx;
  }