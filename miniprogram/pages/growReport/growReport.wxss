.report-page {
    background: #f5f5f5;
    min-height: 100vh;
    padding: 20rpx;
  }
  
  .header-card {
    background: #ff9800;
    color: #fff;
    padding: 30rpx;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
  }
  .header-card .title {
    font-size: 32rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 10rpx;
  }
  .header-card .desc {
    font-size: 26rpx;
    opacity: 0.9;
  }
  
  .report-card {
    background: #fff;
    border-radius: 12rpx;
    padding: 25rpx;
    margin-bottom: 20rpx;
  }
  .section-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 20rpx;
    display: block;
  }
  
  .stage-item {
    margin-bottom: 15rpx;
  }
  .stage-name {
    font-size: 26rpx;
    color: #ff9800;
    font-weight: 500;
    display: block;
    margin-bottom: 5rpx;
  }
  .stage-tip {
    font-size: 24rpx;
    color: #666;
  }
  
  .suggest-item {
    font-size: 26rpx;
    color: #333;
    line-height: 1.6;
    margin-bottom: 10rpx;
  }
  
  .record-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10rpx;
    padding: 10rpx 0;
    border-bottom: 1rpx solid #eee;
  }
  .record-item:last-child {
    border-bottom: none;
  }
  .record-date {
    font-size: 24rpx;
    color: #999;
  }
  .record-content {
    font-size: 26rpx;
    color: #666;
    flex: 1;
    margin-left: 15rpx;
  }
  
  .empty-tip {
    text-align: center;
    color: #999;
    font-size: 26rpx;
    padding: 20rpx 0;
  }