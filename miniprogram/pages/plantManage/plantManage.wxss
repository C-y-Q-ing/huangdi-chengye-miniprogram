.plant-page {
    background: #f5f5f5;
    min-height: 100vh;
    padding: 20rpx;
  }
  
  .header-card {
    background: #ff9800;
    color: #fff;
    padding: 30rpx;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
  }
  .header-card .title {
    font-size: 32rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 10rpx;
  }
  .header-card .desc {
    font-size: 26rpx;
    opacity: 0.9;
  }
  
  .function-list {
    margin-bottom: 30rpx;
  }
  .function-card {
    background: #fff;
    border-radius: 12rpx;
    padding: 25rpx;
    margin-bottom: 15rpx;
    display: flex;
    align-items: center;
  }
  .card-icon {
    font-size: 40rpx;
    margin-right: 20rpx;
  }
  .card-content {
    flex: 1;
  }
  .card-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    display: block;
    margin-bottom: 5rpx;
  }
  .card-desc {
    font-size: 24rpx;
    color: #666;
  }
  
  .record-section {
    background: #fff;
    border-radius: 12rpx;
    padding: 25rpx;
  }
  .section-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    display: block;
    margin-bottom: 20rpx;
  }
  .empty-tip {
    text-align: center;
    color: #999;
    font-size: 26rpx;
    padding: 30rpx 0;
  }
  .record-item {
    border-bottom: 1rpx solid #eee;
    padding: 15rpx 0;
  }
  .record-item:last-child {
    border-bottom: none;
  }
  .record-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8rpx;
  }
  .record-type {
    font-size: 26rpx;
    color: #ff9800;
    font-weight: 500;
  }
  .record-date {
    font-size: 24rpx;
    color: #999;
  }
  .record-content {
    font-size: 26rpx;
    color: #666;
    line-height: 1.4;
  }