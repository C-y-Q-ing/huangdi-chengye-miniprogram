.cart-page {
    background-color: #f5f5f5;
    padding: 20rpx;
    padding-bottom: 120rpx;
  }
  .empty-tip {
    text-align: center;
    margin-top: 200rpx;
    color: #999;
    font-size: 28rpx;
  }
  .cart-item {
    background-color: #fff;
    border-radius: 12rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .item-info {
    flex: 1;
  }
  .item-title {
    font-size: 28rpx;
    color: #333;
  }
  .item-spec {
    font-size: 24rpx;
    color: #666;
    margin-top: 6rpx;
  }
  .item-price {
    font-size: 26rpx;
    color: #ff4d4f;
    margin-top: 10rpx;
  }
  .quantity-control {
    display: flex;
    align-items: center;
  }
  .control-btn {
    width: 50rpx;
    height: 50rpx;
    border: 1rpx solid #eee;
    background-color: #fff;
    border-radius: 8rpx;
    font-size: 28rpx;
    color: #333;
  }
  .num-text {
    margin: 0 20rpx;
    font-size: 26rpx;
  }
  .delete-btn {
    margin-left: 20rpx;
    font-size: 24rpx;
    color: #999;
  }
  .bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 30rpx;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  }
  .total-info {
    font-size: 28rpx;
  }
  .total-price {
    color: #ff4d4f;
    font-weight: bold;
    font-size: 32rpx;
  }
  .checkout-btn {
    background-color: #ff4d4f;
    color: #fff;
    height: 80rpx;
    line-height: 80rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    padding: 0 40rpx;
  }