<view class="cart-page">
  <view wx:if="{{cartList.length === 0}}" class="empty-tip">
    购物车暂无商品
  </view>

  <view wx:else class="cart-list">
    <view class="cart-item" wx:for="{{cartList}}" wx:key="id+spec">
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="item-spec" wx:if="{{!item.isShopMall}}">果型：{{item.spec}}</view>
        <view class="item-spec" wx:if="{{item.isShopMall}}">规格：{{item.spec}}</view>
        <view class="item-price">¥{{item.price}}/{{item.unit}}</view>
      </view>
      <view class="quantity-control">
        <button class="control-btn" bindtap="changeCartNum" 
                data-id="{{item.id}}" data-spec="{{item.spec}}" data-step="-1">-</button>
        <!-- 关键：只显示数字+单位，不拼接任何其他字符 -->
        <text class="num-text">{{item.num}} {{item.unit}}</text>
        <button class="control-btn" bindtap="changeCartNum" 
                data-id="{{item.id}}" data-spec="{{item.spec}}" data-step="1">+</button>
      </view>
      <button class="delete-btn" bindtap="deleteItem" 
              data-id="{{item.id}}" data-spec="{{item.spec}}">删除</button>
    </view>
  </view>
</view>

<view class="bottom-bar" wx:if="{{cartList.length > 0}}">
  <view class="total-info">
    <text>合计：</text>
    <text class="total-price">¥{{totalPrice}}</text>
  </view>
  <button class="checkout-btn" bindtap="goCheckout">去结算</button>
</view>