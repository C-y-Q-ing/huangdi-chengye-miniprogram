<view class="detail-page">
  <image class="goods-img" src="{{goodsInfo.img}}" mode="widthFix"></image>

  <view class="goods-info">
    <view class="goods-title">{{goodsInfo.title}}</view>
    <view class="price-row">
      <text class="current-price">¥{{goodsInfo.price}}</text>
      <text class="unit">/{{goodsInfo.unit}}</text>
    </view>
    <view class="desc-text">{{goodsInfo.type}}，产地直供，新鲜脐橙风味浓郁。</view>
  </view>

<!-- 商品详情介绍 -->
<view class="detail-desc-section">
  <view class="desc-title">商品详情</view>
  <view class="desc-content">{{goodsInfo.desc}}</view>
</view>


  <!-- 仅脐橙：果型选择 -->
  <view class="spec-row" wx:if="{{!isShopMall}}">
    <text>选择果型</text>
    <view class="spec-box">
      <text class="spec-item {{spec==='中果'?'active':''}}" bindtap="selectSpec" data-spec="中果">中果</text>
      <text class="spec-item {{spec==='大果'?'active':''}}" bindtap="selectSpec" data-spec="大果">大果</text>
    </view>
  </view>

  <!-- 仅周边：显示“默认规格” -->
  <view class="spec-row" wx:if="{{isShopMall}}">
    <text>规格：默认规格</text>
  </view>

  <!-- 购买数量 -->
  <view class="quantity-row">
    <text>购买数量（{{goodsInfo.unit}}）</text>
    <view class="quantity-control">
      <button class="control-btn" bindtap="changeNum" data-step="-1">-</button>
      <text class="num-text">{{buyNum}}</text>
      <button class="control-btn" bindtap="changeNum" data-step="1">+</button>
    </view>
  </view>
</view>

<view class="bottom-bar" wx:if="{{goodsInfo.canBuy}}">
  <button class="add-cart-btn" bindtap="addToCart">加入购物车</button>
  <button class="buy-btn" bindtap="buyNow">立即购买</button>
</view>

<view class="tip-bar" wx:else>
  <text class="tip-text">该商品仅支持现场采摘称重，无法线上下单</text>
</view>